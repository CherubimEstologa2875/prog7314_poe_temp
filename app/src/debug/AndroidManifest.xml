<!--
    Debug-only manifest additions (SCRUM-82).

    Gradle merges this into the main manifest for debug builds only, so the
    release build never carries the cleartext exception below
    (Android Developers, 2026).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>

