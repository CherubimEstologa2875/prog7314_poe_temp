<?xml version="1.0" encoding="utf-8"?>
<!--
  Single nav graph, hosted by MainActivity's NavHostFragment (see activity_main.xml).
  There is no separate auth Activity/graph: splash -> onboarding -> sign in -> biometric
  all live here too, and MainActivity hides the bottom bar/FAB for those (and for the
  add-item modal graph) via a destination-changed listener - see MainActivity.CHROMELESS_DESTINATIONS.

  homeFragment / wardrobeFragment / outfitsFragment / profileFragment ids are the four
  bottom-nav tabs and must keep matching menu_bottom_nav.xml exactly.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/runway_nav_graph"
    app:startDestination="@id/signInFragment">

    <!-- ============================= Auth ============================= -->

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.runway.ui.auth.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_stub">
        <action
            android:id="@+id/action_onboarding_to_signIn"
            app:destination="@id/signInFragment" />
    </fragment>

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.example.runway.ui.auth.SignInFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_signin">
        <action
            android:id="@+id/action_signIn_to_biometric"
            app:destination="@id/biometricFragment"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_signIn_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/biometricFragment"
        android:name="com.example.runway.ui.auth.BiometricFragment"
        android:label="Biometric Unlock"
        tools:layout="@layout/fragment_biometric">
        <action
            android:id="@+id/action_biometric_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/biometricFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_biometric_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/biometricFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ============================= Home tab ============================= -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.runway.ui.home.HomeFragment"
        android:label="@string/rw_nav_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_weather"
            app:destination="@id/weatherFragment" />
        <action
            android:id="@+id/action_home_to_notifications"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_home_to_laundry"
            app:destination="@id/laundryFragment" />
        <action
            android:id="@+id/action_home_to_itemDetail"
            app:destination="@id/itemDetailFragment" />
        <action
            android:id="@+id/action_home_to_outfitDetail"
            app:destination="@id/outfitDetailFragment" />
        <action
            android:id="@+id/action_home_to_stats"
            app:destination="@id/statsFragment" />
        <!-- "Wear this" on today's pick asks for a confidence rating. -->
        <action
            android:id="@+id/action_home_to_confidenceSheet"
            app:destination="@id/confidenceSheet" />
    </fragment>

    <fragment
        android:id="@+id/weatherFragment"
        android:name="com.example.runway.ui.home.WeatherFragment"
        android:label="Weather Suggestions"
        tools:layout="@layout/fragment_stub" />

    <!-- ============================= Wardrobe tab ============================= -->

    <fragment
        android:id="@+id/wardrobeFragment"
        android:name="com.example.runway.ui.wardrobe.WardrobeFragment"
        android:label="@string/rw_nav_wardrobe"
        tools:layout="@layout/fragment_wardrobe">
        <action
            android:id="@+id/action_wardrobe_to_itemDetail"
            app:destination="@id/itemDetailFragment" />
        <action
            android:id="@+id/action_wardrobe_to_filterSheet"
            app:destination="@id/filterSheet" />
        <action
            android:id="@+id/action_wardrobe_to_sortSheet"
            app:destination="@id/sortSheet" />
    </fragment>

    <fragment
        android:id="@+id/itemDetailFragment"
        android:name="com.example.runway.ui.itemdetail.ItemDetailFragment"
        android:label="Item Detail"
        tools:layout="@layout/fragment_item_detail">
        <!-- Item ids are Firestore document ids, which are strings. -->
        <argument
            android:name="itemId"
            app:argType="string" />
        <!-- Starts a new outfit with this garment already on the canvas. -->
        <action
            android:id="@+id/action_itemDetail_to_builder"
            app:destination="@id/outfitBuilderFragment" />
        <action
            android:id="@+id/action_itemDetail_to_itemEdit"
            app:destination="@id/itemEditFragment" />
        <action
            android:id="@+id/action_itemDetail_to_colourMatcher"
            app:destination="@id/colourMatcherFragment" />
        <action
            android:id="@+id/action_itemDetail_to_createListing"
            app:destination="@id/createListingFragment" />
        <action
            android:id="@+id/action_itemDetail_to_laundry"
            app:destination="@id/laundryFragment" />
    </fragment>

    <fragment
        android:id="@+id/itemEditFragment"
        android:name="com.example.runway.ui.wardrobe.ItemEditFragment"
        android:label="Edit Item"
        tools:layout="@layout/fragment_stub">
        <!-- Item ids are Firestore document ids, which are strings. -->
        <argument
            android:name="itemId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/colourMatcherFragment"
        android:name="com.example.runway.ui.wardrobe.ColourMatcherFragment"
        android:label="Colour Matcher"
        tools:layout="@layout/fragment_colour_matcher">
        <!-- Item ids are Firestore document ids, which are strings. -->
        <argument
            android:name="itemId"
            app:argType="string" />
        <action
            android:id="@+id/action_colourMatcher_to_itemDetail"
            app:destination="@id/itemDetailFragment" />
        <action
            android:id="@+id/action_colourMatcher_to_builder"
            app:destination="@id/outfitBuilderFragment" />
    </fragment>

    <fragment
        android:id="@+id/laundryFragment"
        android:name="com.example.runway.ui.wardrobe.LaundryFragment"
        android:label="Laundry Basket"
        tools:layout="@layout/fragment_stub" />

    <!-- ============================= Add-item modal flow ============================= -->
    <!-- Entered from MainActivity's FAB via navController.navigate(R.id.addItemGraph).
         tagItemFragment's exit action pops this whole nested graph off, landing on
         itemDetailFragment in whichever tab stack was active when the FAB was tapped. -->

    <navigation
        android:id="@+id/addItemGraph"
        android:label="Add Item"
        app:startDestination="@id/cameraFragment">

        <fragment
            android:id="@+id/cameraFragment"
            android:name="com.example.runway.ui.additem.CameraFragment"
            android:label="Camera"
            tools:layout="@layout/fragment_camera">
            <action
                android:id="@+id/action_camera_to_cutout"
                app:destination="@id/cutoutFragment" />
        </fragment>

        <fragment
            android:id="@+id/cutoutFragment"
            android:name="com.example.runway.ui.additem.CutoutFragment"
            android:label="Cutout Preview"
            tools:layout="@layout/fragment_cutout">
            <action
                android:id="@+id/action_cutout_to_tagItem"
                app:destination="@id/tagItemFragment" />
        </fragment>

        <fragment
            android:id="@+id/tagItemFragment"
            android:name="com.example.runway.ui.additem.TagItemFragment"
            android:label="Tag Item"
            tools:layout="@layout/fragment_tag_item">
            <action
                android:id="@+id/action_tagItem_to_itemDetail"
                app:destination="@id/itemDetailFragment"
                app:popUpTo="@id/addItemGraph"
                app:popUpToInclusive="true" />
        </fragment>

    </navigation>

    <!-- ============================= Outfits tab ============================= -->

    <fragment
        android:id="@+id/outfitsFragment"
        android:name="com.example.runway.ui.outfits.OutfitsFragment"
        android:label="@string/rw_nav_outfits"
        tools:layout="@layout/fragment_outfits">
        <action
            android:id="@+id/action_outfits_to_builder"
            app:destination="@id/outfitBuilderFragment" />
        <action
            android:id="@+id/action_outfits_to_outfitDetail"
            app:destination="@id/outfitDetailFragment" />
        <action
            android:id="@+id/action_outfits_to_dayDetailSheet"
            app:destination="@id/dayDetailSheet" />
    </fragment>

    <fragment
        android:id="@+id/outfitBuilderFragment"
        android:name="com.example.runway.ui.outfits.OutfitBuilderFragment"
        android:label="Outfit Builder"
        tools:layout="@layout/fragment_outfit_builder">
        <!-- Set when editing an existing outfit, empty for a new one. -->
        <argument
            android:name="outfitId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <!-- Set when the builder was opened from a garment. -->
        <argument
            android:name="itemId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_builder_to_outfitDetail"
            app:destination="@id/outfitDetailFragment"
            app:popUpTo="@id/outfitBuilderFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/outfitDetailFragment"
        android:name="com.example.runway.ui.outfits.OutfitDetailFragment"
        android:label="Outfit Detail"
        tools:layout="@layout/fragment_outfit_detail">
        <argument
            android:name="outfitId"
            app:argType="string" />
        <action
            android:id="@+id/action_outfitDetail_to_confidenceSheet"
            app:destination="@id/confidenceSheet" />
        <action
            android:id="@+id/action_outfitDetail_to_builder"
            app:destination="@id/outfitBuilderFragment" />
    </fragment>

    <!-- ============================= Profile tab ============================= -->

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.runway.ui.profile.ProfileFragment"
        android:label="@string/rw_nav_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_stats"
            app:destination="@id/statsFragment" />
        <action
            android:id="@+id/action_profile_to_swapMarket"
            app:destination="@id/swapMarketFragment" />
        <action
            android:id="@+id/action_profile_to_myListings"
            app:destination="@id/myListingsFragment" />
        <action
            android:id="@+id/action_profile_to_notifications"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_profile_to_laundry"
            app:destination="@id/laundryFragment" />
        <!-- Sign-out clears the whole back stack and returns to the sign-in screen. -->
        <action
            android:id="@+id/action_profile_signOut_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/runway_nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/statsFragment"
        android:name="com.example.runway.ui.profile.StatsFragment"
        android:label="Stats &amp; Insights"
        tools:layout="@layout/fragment_stub" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.runway.ui.profile.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_stub" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.runway.ui.profile.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_language"
            app:destination="@id/languageFragment" />
    </fragment>

    <fragment
        android:id="@+id/languageFragment"
        android:name="com.example.runway.ui.profile.LanguageFragment"
        android:label="Language"
        tools:layout="@layout/fragment_stub" />

    <!-- ============================= Swap market ============================= -->

    <fragment
        android:id="@+id/swapMarketFragment"
        android:name="com.example.runway.ui.swap.SwapMarketFragment"
        android:label="Swap Market"
        tools:layout="@layout/fragment_stub">
        <action
            android:id="@+id/action_swapMarket_to_listingDetail"
            app:destination="@id/listingDetailFragment" />
        <action
            android:id="@+id/action_swapMarket_to_createListing"
            app:destination="@id/createListingFragment" />
    </fragment>

    <fragment
        android:id="@+id/listingDetailFragment"
        android:name="com.example.runway.ui.swap.ListingDetailFragment"
        android:label="Listing Detail"
        tools:layout="@layout/fragment_stub">
        <argument
            android:name="listingId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/myListingsFragment"
        android:name="com.example.runway.ui.swap.MyListingsFragment"
        android:label="My Listings"
        tools:layout="@layout/fragment_stub">
        <action
            android:id="@+id/action_myListings_to_listingDetail"
            app:destination="@id/listingDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/createListingFragment"
        android:name="com.example.runway.ui.swap.CreateListingFragment"
        android:label="List For Swap"
        tools:layout="@layout/fragment_stub">
        <argument
            android:name="itemId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <!-- ============================= Bottom sheets ============================= -->

    <dialog
        android:id="@+id/filterSheet"
        android:name="com.example.runway.ui.sheets.FilterSheet"
        android:label="Filter" />

    <dialog
        android:id="@+id/sortSheet"
        android:name="com.example.runway.ui.sheets.SortSheet"
        android:label="Sort" />

    <dialog
        android:id="@+id/dayDetailSheet"
        android:name="com.example.runway.ui.sheets.DayDetailSheet"
        android:label="Day Detail">
        <argument
            android:name="dateISO"
            app:argType="string" />
        <action
            android:id="@+id/action_dayDetailSheet_to_outfitDetail"
            app:destination="@id/outfitDetailFragment" />
        <action
            android:id="@+id/action_dayDetailSheet_to_pickOutfitSheet"
            app:destination="@id/pickOutfitSheet"
            app:popUpTo="@id/dayDetailSheet"
            app:popUpToInclusive="true" />
    </dialog>

    <dialog
        android:id="@+id/pickOutfitSheet"
        android:name="com.example.runway.ui.sheets.PickOutfitSheet"
        android:label="Pick Outfit">
        <argument
            android:name="dateISO"
            app:argType="string" />
    </dialog>

    <dialog
        android:id="@+id/confidenceSheet"
        android:name="com.example.runway.ui.sheets.ConfidenceSheet"
        android:label="Confidence Rating">
        <argument
            android:name="outfitId"
            app:argType="string" />
    </dialog>

    <dialog
        android:id="@+id/confirmSheet"
        android:name="com.example.runway.ui.sheets.ConfirmSheet"
        android:label="Confirm" />


</navigation>
