<?xml version="1.0" encoding="utf-8"?>
<!-- One garment card in the wardrobe grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp">

    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        app:cardBackgroundColor="@color/rw_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/wardrobeItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/rw_wardrobe_item_image"
            android:padding="8dp"
            android:scaleType="fitCenter" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/wardrobeItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/rw_fg"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wardrobeItemMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/rw_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/wardrobeItemStat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/rw_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/wardrobeItemPending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rw_wardrobe_pending"
        android:textColor="@color/rw_muted"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/wardrobeItemMatchScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/wardrobeItemUseInOutfit"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
