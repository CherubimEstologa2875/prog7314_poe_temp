<?xml version="1.0" encoding="utf-8"?>
<!-- Home tab. The notifications bell is added to the header in HomeFragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.home.HomeFragment">

    <com.example.runway.ui.components.ScreenHeaderView
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rwLarge="true"
        app:rwShowBack="false" />

    <androidx.core.widget.NestedScrollView
        style="@style/Widget.Runway.ScreenContent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Weather entry. No numbers until weather data exists. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homeWeatherCard"
                style="@style/Widget.Runway.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rw_space_16"
                android:clickable="true"
                android:focusable="true"
                app:contentPadding="@dimen/rw_space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/rw_bg_icon_well"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:src="@drawable/ic_rw_sun"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/rw_space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/rw_home_weather_title"
                            android:textAppearance="@style/TextAppearance.Runway.Display" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/rw_home_weather_body"
                            android:textAppearance="@style/TextAppearance.Runway.Secondary" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_rw_chevron_right"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Only shown when the API says something needs washing. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homeLaundryCard"
                style="@style/Widget.Runway.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rw_space_12"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/rwAccentSoft"
                app:contentPaddingBottom="@dimen/rw_space_12"
                app:contentPaddingLeft="@dimen/rw_space_16"
                app:contentPaddingRight="@dimen/rw_space_16"
                app:contentPaddingTop="@dimen/rw_space_12"
                app:strokeColor="?attr/colorPrimary"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_rw_droplet"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/rw_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/homeLaundryTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Runway.Body"
                            android:textColor="?attr/colorPrimary"
                            tools:text="3 items need a wash" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/rw_home_laundry_body"
                            android:textAppearance="@style/TextAppearance.Runway.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_rw_chevron_right"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Today's pick -->
            <com.example.runway.ui.components.SectionHeaderView
                android:id="@+id/homePickHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rwTitle="@string/rw_home_todays_pick" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/homePickLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="@dimen/rw_space_24"
                android:indeterminate="true"
                app:indicatorColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homePickCard"
                style="@style/Widget.Runway.Card.Flush"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/homePickOpen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:orientation="horizontal"
                        android:padding="@dimen/rw_space_12">

                        <com.example.runway.ui.outfits.OutfitThumbnailView
                            android:id="@+id/homePickThumb"
                            android:layout_width="120dp"
                            android:layout_height="150dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/rw_space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/homePickName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Runway.Display"
                                tools:text="Friday dinner" />

                            <TextView
                                android:id="@+id/homePickPieces"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/rw_space_4"
                                android:textAppearance="@style/TextAppearance.Runway.Secondary"
                                tools:text="4 pieces" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        style="@style/Widget.Runway.Divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/rw_space_12">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/homeSuggestButton"
                            style="@style/Widget.Runway.Button.Secondary.Small"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/rw_space_8"
                            android:layout_weight="1"
                            android:text="@string/rw_home_suggest_another" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/homeWearButton"
                            style="@style/Widget.Runway.Button.Small"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/rw_home_wear_this" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Used for the empty wardrobe, no outfits, and failed load cases. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homePickEmptyCard"
                style="@style/Widget.Runway.Card.Flush"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <com.example.runway.ui.components.EmptyStateView
                    android:id="@+id/homePickEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Stats -->
            <com.example.runway.ui.components.SectionHeaderView
                android:id="@+id/homeStatsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rwActionText="@string/rw_home_see_all"
                app:rwTitle="@string/rw_home_quick_stats" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.example.runway.ui.components.StatTileView
                    android:id="@+id/homeStatItems"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:rwLabel="@string/rw_stat_items" />

                <com.example.runway.ui.components.StatTileView
                    android:id="@+id/homeStatOutfits"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/rw_space_8"
                    android:layout_weight="1"
                    app:rwLabel="@string/rw_stat_outfits" />

                <com.example.runway.ui.components.StatTileView
                    android:id="@+id/homeStatWears"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/rw_space_8"
                    android:layout_weight="1"
                    app:rwLabel="@string/rw_stat_wears" />

                <com.example.runway.ui.components.StatTileView
                    android:id="@+id/homeStatValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/rw_space_8"
                    android:layout_weight="1"
                    app:rwLabel="@string/rw_stat_value" />
            </LinearLayout>

            <!-- Recently added. Hidden while the wardrobe is empty. -->
            <com.example.runway.ui.components.SectionHeaderView
                android:id="@+id/homeRecentHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rwActionText="@string/rw_home_see_all"
                app:rwTitle="@string/rw_home_recently_added" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeRecentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_recent" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
