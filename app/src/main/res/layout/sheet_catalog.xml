<?xml version="1.0" encoding="utf-8"?>
<!-- Content for the catalog's demonstration bottom sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.35"
        android:text="@string/rw_catalog_sheet_body"
        android:textAppearance="@style/TextAppearance.Runway.Secondary" />

    <com.example.runway.ui.components.ListRowView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rw_space_8"
        app:rwIcon="@drawable/ic_rw_droplet"
        app:rwLabel="@string/rw_catalog_row_wash"
        app:rwShowChevron="true" />

    <com.example.runway.ui.components.ListRowView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rwIcon="@drawable/ic_rw_swap"
        app:rwLabel="@string/rw_catalog_badge_swap"
        app:rwShowChevron="true" />

</LinearLayout>
