<?xml version="1.0" encoding="utf-8"?>
<!-- One garment in full: its photo, what it is, what it has cost, and the way in to the builder. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.example.runway.ui.components.ScreenHeaderView
            android:id="@+id/detailHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:contentDescription="@string/rw_wardrobe_item_image"
            android:padding="16dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/detailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:textAppearance="@style/TextAppearance.Runway.Display" />

        <TextView
            android:id="@+id/detailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/detailPending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:text="@string/rw_wardrobe_unsynced"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <com.example.runway.ui.components.StatTileView
                android:id="@+id/detailWearsTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1" />

            <com.example.runway.ui.components.StatTileView
                android:id="@+id/detailCostTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailUseInOutfitButton"
            style="@style/Widget.Runway.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:text="@string/rw_item_detail_use_in_outfit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailFindMatchesButton"
            style="@style/Widget.Runway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/rw_item_detail_find_matches" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailDeleteButton"
            style="@style/Widget.Runway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/rw_item_detail_delete" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
