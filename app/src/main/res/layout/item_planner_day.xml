<?xml version="1.0" encoding="utf-8"?>
<!-- One day on the planner calendar. Height is set in PlannerDayAdapter so the cells stay 3:4. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/plannerDayCard"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/rwElevated"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="@dimen/rw_border_width">

    <com.example.runway.ui.outfits.OutfitThumbnailView
        android:id="@+id/plannerDayThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/plannerDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Runway.Micro"
        android:textStyle="bold"
        tools:text="22" />
</com.google.android.material.card.MaterialCardView>
