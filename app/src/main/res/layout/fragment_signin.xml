<?xml version="1.0" encoding="utf-8"?>
<!-- Google sign-in screen -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    style="@style/Widget.Runway.ScreenContent"
    tools:context=".ui.auth.SignInFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/rw_auth_logo_size"
            android:layout_height="@dimen/rw_auth_logo_size"
            android:layout_marginTop="64dp"
            android:contentDescription="@string/rw_auth_logo_content_description"
            android:src="@drawable/rw_logo" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:background="@color/rw_accent" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rw_auth_login_title"
            android:textAppearance="@style/TextAppearance.Runway.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rw_auth_login_body"
            android:textAppearance="@style/TextAppearance.Runway.Body"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/authGoogleButton"
            style="@style/Widget.Runway.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/rw_auth_google_button"
            app:icon="@drawable/ic_rw_google" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/rwSurface"
            app:cardCornerRadius="@dimen/rw_radius_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="@dimen/rw_border_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/rw_auth_fingerprint"
                    android:src="@drawable/ic_rw_fingerprint"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/rw_auth_fingerprint"
                    android:textAppearance="@style/TextAppearance.Runway.Body" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/authFingerprintSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/authFingerprintUnavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/rw_auth_fingerprint_unavailable"
            android:textAppearance="@style/TextAppearance.Runway.Caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/authError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="@string/rw_auth_sign_in_failed" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/rw_auth_terms"
            android:textAppearance="@style/TextAppearance.Runway.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
