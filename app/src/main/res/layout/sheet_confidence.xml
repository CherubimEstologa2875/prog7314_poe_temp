<?xml version="1.0" encoding="utf-8"?>
<!-- Contents of the confidence rating sheet. The chrome comes from RunwayBottomSheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/confidencePrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:textAppearance="@style/TextAppearance.Runway.Secondary"
        tools:text="How did you feel in Friday dinner?" />

    <com.example.runway.ui.components.StarRatingView
        android:id="@+id/confidenceStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/rw_space_20"
        app:rwEditable="true"
        app:rwStarSize="large" />

    <!-- Names the score once one is picked, so the stars are not the only feedback. -->
    <TextView
        android:id="@+id/confidenceScoreLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rw_space_8"
        android:gravity="center"
        android:minHeight="20dp"
        android:textAppearance="@style/TextAppearance.Runway.Body"
        android:textColor="?attr/colorPrimary"
        tools:text="Confident" />

    <com.example.runway.ui.components.FieldView
        android:id="@+id/confidenceNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rw_space_16"
        app:rwLabel="@string/rw_confidence_note_label"
        app:rwHint="@string/rw_confidence_note_hint" />

</LinearLayout>
