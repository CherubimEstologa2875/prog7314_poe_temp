<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    style="@style/Widget.Runway.ScreenContent"
    tools:context=".ui.auth.BiometricFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="120dp">

        <TextView
            android:id="@+id/biometricAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/rw_bg_avatar"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            tools:text="DF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/rw_biometric_title"
            android:textAppearance="@style/TextAppearance.Runway.Display" />

        <TextView
            android:id="@+id/biometricEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Runway.Body"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="divanfourie2@gmail.com" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/biometricButton"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="48dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/rwSurface"
            app:cardCornerRadius="48dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="@dimen/rw_border_width">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@string/rw_biometric_avatar_content_description"
                android:src="@drawable/ic_rw_fingerprint"
                app:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/biometricError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/rw_biometric_helper"
            android:textAppearance="@style/TextAppearance.Runway.Body"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/biometricUseAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/rw_biometric_use_account"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
