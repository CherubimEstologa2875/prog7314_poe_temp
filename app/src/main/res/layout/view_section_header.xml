<?xml version="1.0" encoding="utf-8"?>
<!-- Internals of SectionHeaderView: an uppercase label with an optional action. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout"
    tools:orientation="horizontal">

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Runway.Label.Section"
        tools:text="Recently worn" />

    <TextView
        android:id="@+id/sectionAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rw_space_8"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingLeft="@dimen/rw_space_4"
        android:paddingRight="@dimen/rw_space_4"
        android:textAppearance="@style/TextAppearance.Runway.Secondary"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="See all"
        tools:visibility="visible" />

</merge>
