<?xml version="1.0" encoding="utf-8"?>
<!-- Step one of adding an item: a photo of the garment, from the camera or the gallery. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.example.runway.ui.components.ScreenHeaderView
        android:id="@+id/cameraHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/rw_camera_preview_description"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cameraEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="@string/rw_camera_empty"
            android:textColor="?android:attr/textColorSecondary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cameraTakeButton"
            style="@style/Widget.Runway.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/rw_camera_take" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cameraPickButton"
            style="@style/Widget.Runway.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rw_camera_pick" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cameraContinueButton"
        style="@style/Widget.Runway.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:enabled="false"
        android:text="@string/rw_camera_continue" />

</LinearLayout>
