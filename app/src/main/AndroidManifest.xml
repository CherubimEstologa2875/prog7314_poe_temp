<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Required before the app can reach the Runway API. Without it every
        Retrofit call fails with a SecurityException, which is easy to mistake
        for a server problem (Android Developers, 2026). Added for SCRUM-82.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Lets the app tell "offline" apart from "the request failed", which is
        what the sync banner shows the user.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".RunwayApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Runway">

        <!-- Single Activity: hosts the whole nav graph, including auth (splash / onboarding /
             sign in / biometric) - see runway_nav_graph.xml. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Runway.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lets the system camera app write one photo into this app's own storage.
            Not exported: only the app the URI is handed to can use it, and only for
            the folder named in file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Component catalog. Not exported - it is only opened from inside the app. -->
        <activity
            android:name=".ui.catalog.CatalogActivity"
            android:exported="false"
            android:label="@string/rw_catalog_title"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>

